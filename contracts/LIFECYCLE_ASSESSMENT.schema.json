{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AXM Lifecycle Assessment",
  "required": [
    "subject_id",
    "options",
    "evidence_refs",
    "missing_evidence"
  ],
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "options": {
      "type": "object",
      "required": [
        "maintain",
        "evolve",
        "replace"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forced_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
