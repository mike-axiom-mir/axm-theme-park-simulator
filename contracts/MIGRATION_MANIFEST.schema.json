{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AXM Migration Manifest",
  "required": [
    "migration_id",
    "from_version",
    "to_version",
    "description",
    "lossless",
    "rollback_supported"
  ],
  "properties": {
    "migration_id": {
      "type": "string"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lossless": {
      "type": "boolean"
    },
    "rollback_supported": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
