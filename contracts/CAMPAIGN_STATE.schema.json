{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AXM Campaign State",
  "required": [
    "campaign_id",
    "inherited_context",
    "reached_tags",
    "evidence_refs",
    "available_ending_ids"
  ],
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "inherited_context": {
      "type": "object"
    },
    "reached_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_ending_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
