    },
    "primary_promises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "target_audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptable_tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_compromises": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
