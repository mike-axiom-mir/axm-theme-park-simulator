{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AXM Evidence Claim",
  "required": [
    "claim_id",
    "subject_id",
    "statement",
    "confidence",
    "evidence_refs",
    "alternatives",
    "uncertainty_notes"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
