{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AXM Campaign Ending",
  "required": [
    "ending_id",
    "title",
    "required_tags",
    "forbidden_tags",
    "minimum_evidence_refs"
  ],
  "properties": {
    "ending_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "required_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minimum_evidence_refs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
