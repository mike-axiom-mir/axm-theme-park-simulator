{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXM Explanation Packet",
  "type": "object",
  "required": [
    "subject_id",
    "metric_id",
    "result",
    "causes",
    "confidence",
    "evidence_refs",
    "missing_evidence",
    "player_options",
    "tradeoffs",
    "state_version"
  ],
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "metric_id": {
      "type": "string"
    },
    "result": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "causes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "player_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "headline_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
