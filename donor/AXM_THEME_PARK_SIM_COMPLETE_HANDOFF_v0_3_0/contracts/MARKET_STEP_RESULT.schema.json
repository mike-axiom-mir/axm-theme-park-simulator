{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.themepark.market-step-result.schema.json",
  "title": "AXM Conserved Market Step Result v0.3.0",
  "type": "object",
  "required": [
    "prior_state", "next_state", "transitions", "first_time_demand",
    "repeat_demand", "first_time_visits", "repeat_visits",
    "unmet_first_time_demand", "unmet_repeat_demand", "conservation_error"
  ],
  "properties": {
    "prior_state": {"$ref": "AUDIENCE_COHORT.schema.json"},
    "next_state": {"$ref": "AUDIENCE_COHORT.schema.json"},
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_stage", "to_stage", "amount", "cause"],
        "properties": {
          "from_stage": {"type": "string"},
          "to_stage": {"type": "string"},
          "amount": {"type": "number", "minimum": 0},
          "cause": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "first_time_demand": {"type": "number", "minimum": 0},
    "repeat_demand": {"type": "number", "minimum": 0},
    "first_time_visits": {"type": "number", "minimum": 0},
    "repeat_visits": {"type": "number", "minimum": 0},
    "unmet_first_time_demand": {"type": "number", "minimum": 0},
    "unmet_repeat_demand": {"type": "number", "minimum": 0},
    "conservation_error": {"type": "number"}
  },
  "additionalProperties": false
}
