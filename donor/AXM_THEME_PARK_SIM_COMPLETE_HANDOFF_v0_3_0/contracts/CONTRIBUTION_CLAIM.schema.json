{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.themepark.contribution-claim.schema.json",
  "title": "AXM Causal Contribution Claim v0.3.0",
  "type": "object",
  "required": [
    "claim_id",
    "subject_id",
    "beneficiary_id",
    "causal_event_id",
    "channel",
    "amount",
    "direction",
    "attribution_share",
    "source_module",
    "state_version",
    "confidence"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "beneficiary_id": {
      "type": "string",
      "minLength": 1
    },
    "causal_event_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": [
        "crowd_balance_value",
        "direct_revenue",
        "duration_value",
        "heritage_value",
        "identity_value",
        "induced_spend",
        "land_opportunity_cost",
        "maintenance_cost",
        "operating_cost",
        "risk_cost",
        "staffing_cost",
        "strategic_resilience_value",
        "visit_attraction_value"
      ]
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "direction": {
      "enum": [
        "benefit",
        "cost"
      ]
    },
    "attribution_share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_module": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "description": "Finite causal value claim. Attribution shares for one real occurrence may total at most 100%, preventing whole-park value from being counted repeatedly."
}
