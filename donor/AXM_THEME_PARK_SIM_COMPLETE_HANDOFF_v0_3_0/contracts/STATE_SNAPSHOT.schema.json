{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.themepark.state-snapshot.schema.json",
  "title": "AXM State Snapshot v0.3.0",
  "type": "object",
  "required": [
    "snapshot_id",
    "world_id",
    "branch_id",
    "tick",
    "state_version",
    "state_hash",
    "event_log_hash",
    "canonical_root_hash",
    "module_versions",
    "reason",
    "created_by"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_log_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_root_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "module_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "parent_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
