{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.themepark.derived-metric-record.schema.json",
  "title": "AXM Derived Metric Record v0.3.0",
  "type": "object",
  "required": [
    "record_id",
    "metric_id",
    "subject_id",
    "module_id",
    "algorithm_version",
    "state_version",
    "result",
    "unit",
    "contributions",
    "input_record_ids",
    "evidence_refs",
    "confidence"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "metric_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "algorithm_version": {
      "type": "string"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "contributions": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "input_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_inputs_allowed": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
