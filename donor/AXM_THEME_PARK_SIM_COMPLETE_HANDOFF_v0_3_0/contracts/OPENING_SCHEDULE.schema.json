{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXM Opening Schedule",
  "type": "object",
  "required": [
    "schedule_id",
    "weekday_windows"
  ],
  "properties": {
    "schedule_id": {
      "type": "string"
    },
    "weekday_windows": {
      "type": "object",
      "patternProperties": {
        "^[0-6]$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start_minute",
              "end_minute"
            ],
            "properties": {
              "start_minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439
              },
              "end_minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
