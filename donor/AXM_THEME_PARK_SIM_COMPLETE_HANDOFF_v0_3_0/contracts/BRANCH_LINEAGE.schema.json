{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axm.themepark.branch-lineage.schema.json",
  "title": "AXM Explicit Branch Lineage v0.3.0",
  "type": "object",
  "required": [
    "branch_id",
    "parent_branch_id",
    "fork_snapshot_id",
    "label",
    "created_by",
    "status"
  ],
  "properties": {
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_branch_id": {
      "type": "string",
      "minLength": 1
    },
    "fork_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "archived",
        "merged_reference"
      ]
    }
  },
  "additionalProperties": false
}
